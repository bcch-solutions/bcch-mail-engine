# ============================================================
# BCCH MAIL ENGINE — Variables de entorno (ejemplo)
# Copiar a .env y rellenar con valores reales.
# NUNCA incluir secretos reales en este archivo ni en el repositorio.
# ============================================================

# --- Nodos del servicio ---
NODE_ENV=production
# SiteGround asigna el puerto dinámicamente (véalo en Site Tools → Node.js);
# déjelo vacío en SiteGround y el hosting lo inyecta. En VPS/Docker use 8443.
# PORT=8443
LOG_LEVEL=info

# --- URL pública del motor ---
# SiteGround: https://mail-api.bcch.solutions (HTTPS administrado por SiteGround)
# VPS/Docker: detrás de Caddy
ENGINE_PUBLIC_URL=https://mail-api.bcch.solutions

# --- Secreto de servicio (compartido con BCCH MAIL CENTER) ---
# Generar con: openssl rand -hex 48
SERVICE_HMAC_SECRET=replace-with-openssl-rand-hex-48

# --- PostgreSQL ---
# Opción A (recomendada): usar la base de datos Cloud existente con un
# esquema dedicado y un rol restringido. El motor solo accede a mail_engine.
#   DB_SSL=true forza TLS (obligatorio para conexiones externas a Cloud).
#
# IMPORTANTE — TLS del Session Pooler:
# El Session Pooler de Cloud presenta un certificado firmado por una CA que
# NO está en el trust store de Node 22. Para mantener rejectUnauthorized:true
# (validación estricta) debes inyectar el CA raíz de Cloud de una de dos formas:
#
#   1) DB_SSL_CA_FILE=/ruta/absoluta/ca.pem   (archivo PEM en el VPS/hosting)
#   2) DB_SSL_CA="-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----"
#      (PEM completo en una sola variable, con \n o saltos reales)
#
# Obtén el CA raíz de Cloud ejecutando en el VPS/hosting:
#   openssl s_client -showcerts -connect aws-0-<region>.pooler.supabase.com:5432 \
#     -starttls postgres </dev/null 2>/dev/null \
#     | awk '/-----BEGIN CERT/,/-----END CERT/' > ca.pem
# (toma el ÚLTIMO certificado de la cadena, que es la CA raíz).
#
# No incluyas sslmode=... en DATABASE_URL: el motor lo elimina y aplica su
# propia configuración TLS centralizada (rejectUnauthorized:true + CA).
DATABASE_URL=postgres://bcch_engine:CHANGE_ME_ENGINE_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DB_SCHEMA=mail_engine
DB_SSL=true
# DB_SSL_CA_FILE=/home/usuario/bcch-engine/ca.pem
# DB_SSL_CA=-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----
# Opción B (VPS/Docker dedicado): una base de datos propia.
# DATABASE_URL=postgres://bcch_engine:replace-strong-password@127.0.0.1:5432/bcch_mail_engine
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=bcch_engine
# PGPASSWORD=replace-strong-password
# PGDATABASE=bcch_mail_engine

# --- Proveedor de colas persistentes ---
# postgres → sin Redis (recomendado en SiteGround GoGeek)
# redis    → requiere REDIS_URL (VPS/Docker)
QUEUE_PROVIDER=postgres
# REDIS_URL=redis://127.0.0.1:6379/0   # solo si QUEUE_PROVIDER=redis

# --- Modalidad de sincronización ---
# persistent → workers + IMAP IDLE (requiere procesos Node persistentes)
# periodic   → conexiones IMAP de corta duración; sincronización vía cron
#              (node dist/scripts/sync-cron.js), al abrir el buzón o por API
SYNC_MODE=periodic

# --- Integración con Cloud (gestor de usuarios/dominios/cuentas) ---
# El motor lee metadatos de cuentas vía Data API con clave publicable (TO anon).
# Nunca expone SUPABASE_SERVICE_ROLE_KEY al motor; las credenciales de correo
# se sirven cifradas por la aplicación principal.
BUILDER_SUPABASE_URL=https://ylkbtamspmetuqnyikfo.supabase.co
BUILDER_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# --- Cifrado de credenciales de correo (AES-256-GCM) ---
# Clave separada de la base de datos. Rotar periódicamente.
# Generar con: openssl rand -hex 32
CREDENTIAL_ENC_KEY=replace-with-openssl-rand-hex-32

# --- Restricciones de red (protección SSRF) ---
# Solo permitir IMAP/SMTP a dominios autorizados.
ALLOWED_MAIL_DOMAINS=bcch.solutions,net-capital.net
# Puertos permitidos (993 IMAP/TLS, 465 SMTP/TLS, 587 SMTP/STARTTLS)
ALLOWED_PORTS=993,465,587
# Bloquear redes internas privadas (RFC1918 / loopback)
BLOCK_PRIVATE_NETWORKS=true

# --- Sincronización ---
SYNC_INITIAL_DAYS=30
SYNC_MAX_CONCURRENCY=4
# IDLE solo aplica en SYNC_MODE=persistent
SYNC_IDLE_ENABLED=true
SYNC_IDLE_RECONNECT_MS=30000

# --- Cola de envío SMTP ---
SMTP_MAX_CONCURRENCY=2
SMTP_MAX_RETRIES=5
SMTP_RETRY_BACKOFF_MS=2000
SMTP_RATE_LIMIT_PER_MIN=30

# --- Retención / limpieza ---
ATTACHMENT_RETENTION_DAYS=30
TEMP_DIR=/tmp/bcch-engine

# --- CORS ---
CORS_ALLOWED_ORIGIN=https://webmail.bcch.solutions